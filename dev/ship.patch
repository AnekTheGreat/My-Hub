+/* ---- a little life ---- */
+
+var countShown = 0;
+
+function calm(){
+  return !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
+}
+
+function greeting(){
+  var h = new Date().getHours();
+  if (h < 5) return 'Still awake';
+  if (h < 12) return 'Good morning';
+  if (h < 17) return 'Good afternoon';
+  if (h < 22) return 'Good evening';
+  return 'Late night';
+}
+
+function hello(){
+  var el = document.getElementById('hello');
+  if (!el || !S || !S.cards) return;
+  var n = S.cards.filter(function(c){ return !!c.pkg; }).length;
+  el.innerHTML = greeting() + (n ? ', <b>' + n + '</b> ' + (n === 1 ? 'app' : 'apps') + ' ready' : '');
+}
+
+/* The total arrives by counting, so a fresh number reads as a change rather than a fact. */
+function countTo(ms){
+  var el = document.getElementById('summary');
+  if (!el || !(ms > 0)) return;
+  if (calm()){ el.textContent = human(ms) + ' across your apps'; countShown = ms; return; }
+  var from = countShown, to = ms, t0 = Date.now();
+  countShown = to;
+  (function step(){
+    var k = Math.min(1, (Date.now() - t0) / 700);
+    var eased = 1 - Math.pow(1 - k, 3);
+    el.textContent = human(Math.round(from + (to - from) * eased)) + ' across your apps';
+    if (k < 1) requestAnimationFrame(step);
+  })();
+}
+
+function burst(x, y){
+  if (calm()) return;
+  var host = document.getElementById('burst');
+  if (!host){
+    host = document.createElement('div');
+    host.id = 'burst';
+    document.body.appendChild(host);
+  }
+  var colors = ['#63C6A6', '#7FB3F0', '#F2C14E', '#E88AA8', '#B49BF2'];
+  // `let`, because each spark's finish clears its OWN element: with `var` every callback would
+  // close over the last one and leave the rest of the confetti in the document for ever.
+  for (let i = 0; i < 16; i++){
+    let spark = document.createElement('i');
+    spark.className = 'spark';
+    spark.style.background = colors[i % colors.length];
+    spark.style.left = (x || window.innerWidth / 2) + 'px';
+    spark.style.top = (y || window.innerHeight / 2) + 'px';
+    host.appendChild(spark);
+    let ang = Math.PI * 2 * i / 16 + Math.random() * 0.5;
+    let dist = 46 + Math.random() * 64;
+    spark.animate([
+      { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 },
+      { transform: 'translate(' + (Math.cos(ang) * dist - 4).toFixed(1) + 'px,' +
+                     (Math.sin(ang) * dist - 4).toFixed(1) + 'px) scale(.2)', opacity: 0 }
+    ], { duration: 560 + Math.random() * 240, easing: 'cubic-bezier(.2,.7,.3,1)' })
+      .onfinish = function(){ spark.remove(); };
+  }
+}
+
+function celebrate(el){
+  try{
+    var r = el && el.getBoundingClientRect ? el.getBoundingClientRect() : null;
+    burst(r ? r.left + r.width / 2 : null, r ? r.top + r.height / 2 : null);
+  }catch (e){}
+}
