<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The hub asks the phone what is installed and starts other apps. Neither needs a permission.
      The one thing it does ask for is Usage access, and that is not a runtime permission: it is a
      switch the owner turns on once, in Settings, that lets the hub read how long another app was
      in front. Without the switch nothing is recorded and no number is invented; the card offers
      the switch instead. Nothing is read, sent, or stored anywhere except the name of an app you
      picked by hand and the time each card's app was actually on screen.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!--
      WITHOUT THIS BLOCK THE HUB CANNOT SEE ANYTHING ON ANDROID 11 OR LATER.
      From API 30 the system hides other packages from an app unless it asks for them, and the
      asking is done here, in the manifest, not at runtime: getLaunchIntentForPackage() and
      queryIntentActivities() quietly answer with nothing for a package the app cannot see. That
      is what left every card reading "Not installed" on a phone that had all the apps on it, and
      what stopped a card that did find its app from starting it.

      The intent below is the launcher signature: declaring it makes every app with a launcher
      icon visible, which is exactly the set a hub wants - the cards' own apps and the "choose the
      app" list are both built from it. It is the purpose-built alternative to QUERY_ALL_PACKAGES,
      which asks for far more than this needs. The four packages are named outright as well, so a
      build that is present but has no launcher activity of its own is still visible to its card.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.familytree.app" />
        <package android:name="com.SideCut.myapp" />
        <package android:name="com.SideCut.myapp.full" />
        <package android:name="com.CompassEDC.myapp" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyHub">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
